# ---- Environment: development | production ----
APP_ENV=development

# ---- Server ----
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173

# ---- Database (async MySQL) ----
DATABASE_URL=mysql+aiomysql://master_language:master_language@localhost:3306/master_language?charset=utf8mb4

# ---- Redis ----
REDIS_URL=redis://localhost:6379/0

# ---- Auth (use strong secret in production) ----
JWT_SECRET_KEY=dev-secret-change-in-production-min-32-chars
