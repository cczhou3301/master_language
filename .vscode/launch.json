{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Backend (debug)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "app.main:app",
        "--host",
        "0.0.0.0",
        "--port",
        "8000"
      ],
      "cwd": "${workspaceFolder}/backend",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/backend",
        "APP_ENV": "development",
        "DEBUG": "true"
      },
      "justMyCode": false
    },
    {
      "name": "Backend: current file (fix ModuleNotFoundError)",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "cwd": "${workspaceFolder}/backend",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/backend",
        "APP_ENV": "development",
        "DEBUG": "true"
      },
      "justMyCode": false
    },
    {
      "name": "Backend (debug + reload)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "app.main:app",
        "--reload",
        "--host",
        "0.0.0.0",
        "--port",
        "8000"
      ],
      "cwd": "${workspaceFolder}/backend",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/backend",
        "APP_ENV": "development",
        "DEBUG": "true"
      },
      "justMyCode": false
    }
  ]
}